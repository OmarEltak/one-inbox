[Unit]
Description=One Inbox — Whisper transcription worker
After=network.target redis-server.service mysql.service
Requires=redis-server.service

[Service]
Type=simple
User=deploy
Group=www-data
WorkingDirectory=/var/www/ot1-pro.com
ExecStart=/usr/bin/php artisan queue:work redis --queue=transcription --sleep=3 --tries=1 --max-time=3600 --timeout=90
# `always`, not `on-failure`, because `php artisan queue:restart` (fired on
# every deploy) makes this worker exit CLEANLY (status=0) after its current
# job. `on-failure` treats that as intentional and does NOT restart it —
# transcription silently dies for hours. `always` restarts on any exit.
Restart=always
RestartSec=5
Nice=10
CPUQuota=80%
MemoryMax=3G

KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
